# Example environment for running the logfilter daemon.
# Copy to .env and fill in.

# Required
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CONTRACT_ADDRESS=0xYourDeployedContract,0xAnotherContract

# Optional
START_BLOCK=0
CONFIRM_BLOCKS=6
BATCH_SIZE=1000
LIVE_POLL_INTERVAL=12s
REDIS_ADDR=redis:6379
CHECKPOINT_FILE=./checkpoint.json
METRICS_ADDR=:8080
# KAFKA_BROKERS=kafka:9092
# KAFKA_TOPIC=evm_logs
